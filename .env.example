# Copy to .env on the server and fill in. Never commit .env.

# Domain the site is served on (DNS A record → the server).
RIKZ_DOMAIN=report.example.com
RIKZ_PUBLIC_URL=https://report.example.com

# --- Option A: bundled PostgreSQL + files on this server (docker-compose.yml) ---
POSTGRES_PASSWORD=

# --- Option B: Supabase (docker-compose.supabase.yml) ---
# Project Settings → Database → Connection string → "Session pooler" (port 5432), with your DB password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=rikz                       # default on Supabase; keeps tables out of the public web API
# Project Settings → API: project URL and the service_role key (secret; never put it in a browser or in git).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=statements         # created private on first start

# From `docker compose run --rm web rikz make-keys` (keys are shown once; keep them safe).
RIKZ_SECRET_KEY=
RIKZ_VIEW_TOKEN=
RIKZ_VIEW_KEY_HASH=
RIKZ_ADMIN_TOKEN=
RIKZ_ADMIN_KEY_HASH=

# E-mail (optional; without it notices stay queued).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RIKZ_SHAREHOLDER_EMAILS=
RIKZ_ADMIN_EMAILS=
RIKZ_SHAREHOLDER_EMAIL_MODE=review

# Google Drive watcher (optional). Paste the service-account key JSON on one line.
DRIVE_FOLDER_IDS=
GOOGLE_SERVICE_ACCOUNT_JSON=
RIKZ_DRIVE_WAIT_HOURS=48
